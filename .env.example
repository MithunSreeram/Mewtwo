# Anthropic API key — required for AI features
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (defaults to claude-opus-4-5)
MEWTWO_MODEL=claude-opus-4-5

# HTTP proxy for all outbound requests (optional)
# MEWTWO_PROXY=http://127.0.0.1:8080

# Root directory for workspaces (defaults to ~/.mewtwo/workspaces)
# MEWTWO_WORKSPACES_DIR=/path/to/workspaces

# Request timeout in seconds (default: 30)
# MEWTWO_TIMEOUT=30

# Max concurrent HTTP requests (default: 20)
# MEWTWO_CONCURRENCY=20

# Max requests/second during active hunting — politeness throttle (default: 0 = unlimited)
# MEWTWO_RATE_LIMIT=10

# --- Authenticated scanning (inject a session into all hunt requests) ---
# Raw Cookie header value
# MEWTWO_AUTH_COOKIE=session=abc123; csrf=def456
# Bearer token (without the 'Bearer ' prefix)
# MEWTWO_AUTH_BEARER=eyJhbGci...
# Any extra auth header as 'Name: value'
# MEWTWO_AUTH_HEADER=X-API-Key: secret
